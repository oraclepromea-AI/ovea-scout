# Ovea Scout Environment Configuration

# Sui network (testnet, devnet, localnet)
SUI_NETWORK=testnet

# Sui Full node RPC URL (optional; defaults to public testnet)
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# Sui private key for settlement wallet — base64 encoded 32-byte seed.
# NEVER commit a real key to source control.
SUI_PRIVATE_KEY=

# Max single transaction value (MIST, i.e., 1e6 = 1 USDC@6dec)
SUI_MAX_TX_MIST=1000000

# Max daily spend per agent (MIST)
SUI_MAX_DAILY_MIST=5000000

# Emergency shutdown (set 'true' to halt all new settlements)
SUI_EMERGENCY_SHUTDOWN=false

# OmniRoute local gateway (free inference, primary provider)
OMNIROUTE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_KEY=omni-hermes-...

# Optional: OpenRouter free tier fallback
OPENROUTER_KEY=

# Port for the HTTP/Express API server
PORT=8080

# Ledger file path
LEDGER_PATH=./data/ovea-ledger.jsonl

# Platform fee receiver address (defaults to settle.address if not set)
PLATFORM_FEE_ADDRESS=
